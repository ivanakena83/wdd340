<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 800px;
            margin: 40px auto;
            padding: 20px;
            line-height: 1.6;
            color: #2c3e50;
        }
        h1 {
            color: #2c3e50;
            border-bottom: 3px solid #9b59b6;
            padding-bottom: 10px;
        }
        nav {
            margin: 20px 0;
            padding: 10px 0;
            border-bottom: 1px solid #ddd;
        }
        nav a {
            margin-right: 15px;
            text-decoration: none;
            color: #3498db;
            font-weight: bold;
        }
        nav a:hover {
            text-decoration: underline;
        }
        .category-list {
            list-style: none;
            padding: 0;
        }
        .category-list li {
            background: #f8f9fa;
            padding: 14px 20px;
            margin: 8px 0;
            border-radius: 6px;
            border-left: 4px solid #9b59b6;
        }
        .category-name {
            font-size: 1.1em;
            font-weight: 500;
            color: #2c3e50;
        }
        .category-id {
            color: #7f8c8d;
            font-size: 0.85em;
            margin-left: 10px;
        }
        .empty {
            color: #7f8c8d;
            font-style: italic;
            text-align: center;
            padding: 30px;
        }
        footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
            color: #7f8c8d;
            font-size: 0.9em;
        }
    </style>
</head>
<body>
    <h1><%= title %> (<%= categories ? categories.length : 0 %>)</h1>
    
    <nav>
        <a href="/">Home</a>
        <a href="/organizations">Organizations</a>
        <a href="/projects">Projects</a>
        <a href="/categories">Categories</a>
    </nav>

    <% if (categories && categories.length > 0) { %>
        <ul class="category-list">
            <% categories.forEach(category => { %>
                <li>
                    <span class="category-name"><%= category.name %></span>
                    <span class="category-id">(ID: <%= category.id %>)</span>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <div class="empty">No categories found.</div>
    <% } %>

    <footer>
        <p>&copy; 2026 Service Project Directory</p>
    </footer>
</body>
</html>
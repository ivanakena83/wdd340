<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Service Project Directory</title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <header>
        <div class="logo">🌍 Service Project Directory</div>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/organizations">Organizations</a></li>
                <li><a href="/projects">Projects</a></li>
                <li><a href="/categories">Categories</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <h1><%= title %></h1>
        
        <% if (organizations && organizations.length > 0) { %>
            <div class="card-grid">
                <% organizations.forEach(org => { %>
                    <div class="card">
                        <h2><a href="/organizations/<%= org.id %>"><%= org.name %></a></h2>
                        <p><%= org.description ? org.description.substring(0, 150) + '...' : 'No description available' %></p>
                        <% if (org.website) { %>
                            <p><a href="<%= org.website %>" target="_blank">Visit Website</a></p>
                        <% } %>
                        <p class="meta">Created: <%= new Date(org.created_at).toLocaleDateString() %></p>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <p>No organizations found in the database.</p>
        <% } %>
    </main>

    <footer>
        <p>&copy; 2026 Service Project Directory. All rights reserved.</p>
    </footer>
</body>
</html>
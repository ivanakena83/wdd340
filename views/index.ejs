<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Service Project Directory</title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <header>
        <div class="logo">🌍 Service Project Directory</div>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/organizations">Organizations</a></li>
                <li><a href="/projects">Projects</a></li>
                <li><a href="/categories">Categories</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <h1>Welcome to the Service Project Directory</h1>
        <p>Discover and connect with service organizations, projects, and categories in your community.</p>
        
        <div class="feature-grid">
            <div class="feature-card">
                <h2>🏢 Organizations</h2>
                <p>Browse through our partner organizations making a difference.</p>
                <a href="/organizations" class="btn">View Organizations</a>
            </div>
            
            <div class="feature-card">
                <h2>📋 Projects</h2>
                <p>Explore service projects and find opportunities to get involved.</p>
                <a href="/projects" class="btn">View Projects</a>
            </div>
            
            <div class="feature-card">
                <h2>🏷️ Categories</h2>
                <p>Discover service areas and find projects that match your interests.</p>
                <a href="/categories" class="btn">View Categories</a>
            </div>
        </div>
    </main>

    <footer>
        <p>&copy; 2026 Service Project Directory. All rights reserved.</p>
    </footer>
</body>
</html>